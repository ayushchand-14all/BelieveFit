{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RENDER-SERVICE.onrender.com/api/:path*"
    },
    {
      "source": "/videos/:path*",
      "destination": "https://YOUR-RENDER-SERVICE.onrender.com/videos/:path*"
    },
    {
      "source": "/output/:path*",
      "destination": "https://YOUR-RENDER-SERVICE.onrender.com/output/:path*"
    }
  ]
}
